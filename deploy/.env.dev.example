# The dev environment. In Coolify: paste these under Environment Variables and fill in the secrets.
# The dev site's address: the domain on the web service.
PUBLIC_URL=https://devtickets.michaelbielen.be
STORAGE_ACCESS_KEY=mytickets
# A long random string, e.g. from: openssl rand -hex 32
STORAGE_SECRET_KEY=
# The test checkout: no money moves. Or put Stripe test keys below and set this to false.
USE_TEST_CHECKOUT=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The mail account emails are sent from (password reset links, tickets). Without EMAIL_HOST and EMAIL_FROM
# nothing is sent: the email is only written to the API's log. Port 465 uses TLS, others STARTTLS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=MyTickets
