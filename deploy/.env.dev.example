# The dev API. Copy to deploy/.env on the dev server and fill in the secrets.
STAGE=dev
# The API's public address (the Cloudflare Tunnel's hostname), for reference.
API_DOMAIN=devticketsapi.michaelbielen.be
# The address of the dev site on Vercel (a Preview deployment or its own domain).
PUBLIC_URL=https://REPLACE-ME.vercel.app
STORAGE_ACCESS_KEY=mytickets
# A long random string, e.g. from: openssl rand -hex 32
STORAGE_SECRET_KEY=
# The test checkout: no money moves. Or put Stripe test keys below and set this to false.
USE_TEST_CHECKOUT=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where port 8001 listens: 127.0.0.1 (only for cloudflared on this server) or 0.0.0.0.
API_BIND=127.0.0.1
