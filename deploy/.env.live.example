# The live API. Copy to deploy/.env on the live server and fill in the secrets.
STAGE=live
# The API's public address (the Cloudflare Tunnel's hostname), for reference.
API_DOMAIN=myticketsapi.michaelbielen.be
# The address of the live site on Vercel (the Production domain).
PUBLIC_URL=https://REPLACE-ME
STORAGE_ACCESS_KEY=mytickets
# A long random string, e.g. from: openssl rand -hex 32
STORAGE_SECRET_KEY=
# Live takes real payments through Stripe.
USE_TEST_CHECKOUT=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where port 8001 listens: 127.0.0.1 (only for cloudflared on this server) or 0.0.0.0.
API_BIND=127.0.0.1
