# The live environment. In Coolify: paste these under Environment Variables and fill in the secrets.
# The live site's address: the domain on the web service.
PUBLIC_URL=https://mytickets.michaelbielen.be
STORAGE_ACCESS_KEY=mytickets
# A long random string, e.g. from: openssl rand -hex 32
STORAGE_SECRET_KEY=
# Live takes real payments through Stripe. Set this to true (test checkout) until the live Stripe keys are filled in.
USE_TEST_CHECKOUT=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The mail account emails are sent from (password reset links, tickets). Without EMAIL_HOST and EMAIL_FROM
# nothing is sent: the email is only written to the API's log. Port 465 uses TLS, others STARTTLS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=MyTickets
